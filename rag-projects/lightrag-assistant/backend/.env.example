# ---- Google Gemini -------------------------------------------------------
# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_LLM_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=1536
EMBEDDING_MAX_TOKEN_SIZE=2048

# ---- Neo4j (must match docker-compose.yml) -------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=please-change-me
NEO4J_DATABASE=neo4j

# ---- LightRAG / domain ---------------------------------------------------
WORKING_DIR=./rag_storage
DOCUMENT_FOLDER=./data/documents
DEFAULT_QUERY_MODE=hybrid
DEFAULT_HISTORY_TURNS=3
RESPONSE_LANGUAGE=Vietnamese

# ---- Server --------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
# JSON array of allowed CORS origins (pydantic-settings v2 requires JSON for list fields)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
