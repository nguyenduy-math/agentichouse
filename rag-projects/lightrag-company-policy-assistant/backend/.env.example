# ── Google Gemini ──────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
# Alternative: GOOGLE_API_KEY=your-key  (either name is accepted)
GEMINI_LLM_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=1536
EMBEDDING_MAX_TOKEN_SIZE=2048

# ── Neo4j (LightRAG graph storage) ────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=please-change-me
NEO4J_DATABASE=neo4j

# ── Storage paths ──────────────────────────────────────────────────────────────
DOCUMENT_FOLDER=./data/documents
LIGHTRAG_BASE_DIR=./rag_storage/lightrag     # each domain agent appends /{domain}/
PAGEINDEX_BASE_DIR=./rag_storage/pageindex   # each domain agent appends /{domain}/

# ── Domain / response ─────────────────────────────────────────────────────────
RESPONSE_LANGUAGE=English
DEFAULT_HISTORY_TURNS=3

# ── Server ─────────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
