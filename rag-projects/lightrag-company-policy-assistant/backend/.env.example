# ── Google Gemini ──────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
# Alternative: GOOGLE_API_KEY=your-key  (either name is accepted)
GEMINI_LLM_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=1536
EMBEDDING_MAX_TOKEN_SIZE=2048

# ── Neo4j (LightRAG graph storage) ────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=please-change-me
NEO4J_DATABASE=neo4j

# ── PageIndex Cloud ────────────────────────────────────────────────────────────
PAGEINDEX_API_KEY=your-pageindex-api-key-here   # from https://dash.pageindex.ai/api-keys

# ── Storage paths ──────────────────────────────────────────────────────────────
DOCUMENT_FOLDER=./data/documents
LIGHTRAG_BASE_DIR=./rag_storage/lightrag     # each domain agent appends /{domain}/
PAGEINDEX_BASE_DIR=./rag_storage/pageindex   # each domain agent appends /{domain}/

# ── Domain / response ─────────────────────────────────────────────────────────
# Drives the output language stated in every prompt (synthesis, answers, …).
RESPONSE_LANGUAGE=Vietnamese
DEFAULT_HISTORY_TURNS=3
# Turns of history fed to the domain classifier so follow-ups route correctly.
CLASSIFY_HISTORY_TURNS=2

# ── Context-window budgets (token estimates, not characters) ────────────────────
SYNTHESIS_INPUT_BUDGET_TOKENS=4000   # merged specialist answers → synthesis prompt
TREE_NAV_BUDGET_TOKENS=4000          # compacted PageIndex tree → navigation prompt
ANSWER_CONTENT_BUDGET_TOKENS=3000    # extracted page text → answer prompt
MAX_DOCS_PER_SYNTHESIS=5             # cap fan-out before synthesis
MAX_SECTIONS_PER_DOC=3               # cap sections read per document
TREE_MAX_DEPTH=3                     # how deep to walk the PageIndex tree
TREE_SUMMARY_CHAR_CAP=200            # per-node summary trim in the nav prompt

# ── Server ─────────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
