# LLM provider selection: gemini | openai
LLM_PROVIDER=gemini

GOOGLE_API_KEY=your_google_api_key_here

# Gemini models (used when LLM_PROVIDER=gemini)
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_DIM=3072

# OpenAI (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=company2024

# Tuning (optional)
CHUNK_SIZE=2800
CHUNK_OVERLAP=400
MAX_LOCAL_CHUNKS=8
MAX_COMMUNITY_SUMMARIES=5
GRAPH_HOP_DEPTH=2
ENTITY_EXTRACTION_BATCH=5
SESSION_TTL_SECONDS=3600

CORS_ORIGINS=["http://localhost:5175","http://localhost:3000","http://localhost:80"]

# Retry / re-ask limit (frontend will retry this many times on fallback answers)
MAX_CHAT_RETRIES=3

# Reranking (Cohere). Leave COHERE_API_KEY empty to disable.
ENABLE_RERANK=true
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-multilingual-v3.0
RERANK_CANDIDATE_POOL=25
RERANK_TOP_N=8
