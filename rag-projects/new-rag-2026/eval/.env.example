# ── RAG backend ───────────────────────────────────────────────────────────────
NEW_RAG_API_URL=http://localhost:8000

# ── Judge LLM provider ────────────────────────────────────────────────────────
# Choose one: openai | gemini | siliconflow
JUDGE_PROVIDER=openai

# ── API keys ──────────────────────────────────────────────────────────────────
# OPENAI_API_KEY is always required (used for text-embedding-3-small regardless
# of judge provider, because Gemini/SiliconFlow embeddings are not RAGAS-compatible)
OPENAI_API_KEY=

# Only needed if JUDGE_PROVIDER=gemini
GEMINI_API_KEY=

# Only needed if JUDGE_PROVIDER=siliconflow
SILICONFLOW_API_KEY=

# ── Judge model overrides (optional) ─────────────────────────────────────────
# Defaults: gpt-4o-mini / gemini-2.0-flash / deepseek-ai/DeepSeek-V3
OPENAI_JUDGE_MODEL=gpt-4o-mini
# GEMINI_JUDGE_MODEL=gemini-2.0-flash
# SILICONFLOW_JUDGE_MODEL=deepseek-ai/DeepSeek-V3
