GOOGLE_API_KEY=your_google_api_key_here

# LLM provider: gemini | openai  (default: gemini)
LLM_PROVIDER=gemini

# OpenAI (only required when LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Gemini models
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_DIM=3072

# Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=techviet2024

# Tuning (optional)
CHUNK_SIZE=2800
CHUNK_OVERLAP=400
MAX_LOCAL_CHUNKS=8
MAX_COMMUNITY_SUMMARIES=5
GRAPH_HOP_DEPTH=2
ENTITY_EXTRACTION_BATCH=5
SESSION_TTL_SECONDS=3600

CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:80"]
