# ---- LLM (SiliconFlow / OpenAI-compatible) --------------------------------
LLM_API_KEY=your-siliconflow-api-key-here
LLM_API_BASE=https://api.siliconflow.cn/v1
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# ---- PostgreSQL ----------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://fraud:fraud-secret@localhost:5432/fraud_detection

# ---- Neo4j (must match docker-compose.yml) --------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=fraud-neo4j-secret

# ---- Batch pipeline ------------------------------------------------------
BATCH_CRON_HOUR=2
BATCH_CRON_MINUTE=0
# Max claims to analyze per batch run (safety cap)
BATCH_MAX_CLAIMS=500

# ---- Scoring weights (must sum to 1.0) -----------------------------------
LLM_SCORE_WEIGHT=0.7
RULE_SCORE_WEIGHT=0.3

# ---- Server --------------------------------------------------------------
HOST=127.0.0.1
PORT=8001
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
