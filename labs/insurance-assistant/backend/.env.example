# Nhà cung cấp LLM đang dùng: "gemini" hoặc "siliconflow"
LLM_PROVIDER=gemini

# Gemini (google-genai) — bắt buộc khi LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_LLM_MODEL=gemini-2.5-flash

# SiliconFlow (OpenAI-compatible) — bắt buộc khi LLM_PROVIDER=siliconflow
SILICONFLOW_API_KEY=your-siliconflow-api-key-here
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_LLM_MODEL=Qwen/Qwen2.5-72B-Instruct

SESSION_TTL_MINUTES=60
