# Vision LLM provider for claim field extraction
# Options: "gemini" (default) or "siliconflow"
VISION_PROVIDER=gemini

# Gemini — required when VISION_PROVIDER=gemini
# Get your key at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Siliconflow — required when VISION_PROVIDER=siliconflow
# Get your key at https://siliconflow.cn
SILICONFLOW_API_KEY=your_siliconflow_api_key_here
