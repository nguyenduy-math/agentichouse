# PageIndex Cloud — lấy API key tại https://dash.pageindex.ai/api-keys
PAGEINDEX_API_KEY=

# Gemini — lấy API key tại https://aistudio.google.com/app/apikey
# (chấp nhận cả GEMINI_API_KEY hoặc GOOGLE_API_KEY)
GEMINI_API_KEY=

# Tuỳ chọn — ghi đè mặc định
